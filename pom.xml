<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.contactapp</groupId>
    <artifactId>contact-app-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Contact App Automation</name>
    <description>Selenium + Cucumber BDD test automation framework for the Contact List web application</description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <selenium.version>4.21.0</selenium.version>
        <webdrivermanager.version>5.8.0</webdrivermanager.version>
        <cucumber.version>7.15.0</cucumber.version>
        <junit.version>4.13.2</junit.version>
        <cucumber-reporting.version>5.7.7</cucumber-reporting.version>

        <!-- Overridable via -Dreport.buildNumber=$BUILD_NUMBER from CI -->
        <report.buildNumber>local</report.buildNumber>
    </properties>

    <dependencies>
        <!-- Selenium WebDriver -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- WebDriverManager: auto-downloads/manages browser drivers -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>

        <!-- Cucumber BDD -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit</artifactId>
            <version>${cucumber.version}</version>
        </dependency>

        <!-- JUnit 4 runner for Cucumber -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <includes>
                        <include>**/*Runner.java</include>
                    </includes>
                    <testFailureIgnore>false</testFailureIgnore>
                </configuration>
            </plugin>
            <!--
              Turns the Cucumber JSON output into a polished, standalone HTML report
              (trends, feature/scenario breakdown, embedded failure screenshots).
              Not bound to a lifecycle phase on purpose: `mvn test` fails fast on
              scenario failures (as it should, for CI gating), which would stop a
              phase-bound plugin from ever running on a failed build — exactly when
              a report is most wanted. Run it as a separate, explicit step instead:

                mvn test                                                # may exit non-zero
                mvn net.masterthought:maven-cucumber-reporting:generate  # always runs

              Report lands in target/cucumber-html-reports/overview-features.html
            -->
            <plugin>
                <groupId>net.masterthought</groupId>
                <artifactId>maven-cucumber-reporting</artifactId>
                <version>${cucumber-reporting.version}</version>
                <configuration>
                    <projectName>contact-app-automation</projectName>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <inputDirectory>${project.build.directory}/cucumber-reports</inputDirectory>
                    <jsonFiles>
                        <jsonFile>*.json</jsonFile>
                    </jsonFiles>
                    <buildNumber>${report.buildNumber}</buildNumber>
                    <checkBuildResult>false</checkBuildResult>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
